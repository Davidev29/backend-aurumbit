{
  "name": "@aurum-bit/api",
  "version": "0.1.0",
  "private": true,
  "description": "Aurum Bit API — monólito modular NestJS (esqueleto T2 Fase 1, sem regra de negócio).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
