# =============================================================================
# .env.example — TEMPLATE prod-ready (Fase 7 T2)
# =============================================================================
# COMO USAR:
#   - DEV/CI: `cp .env.example .env` (placeholders permitem boot local; o compose
#     usa os fallbacks de desenvolvimento).
#   - PROD:  NÃO edite este arquivo à mão — gere com
#            `bash deploy/scripts/gen-prod-env.sh` na VPS e complete Asaas/Resend
#            no cofre. O arquivo gerado (`.env.prod`) tem `chmod 600` e NUNCA é
#            commitado (ver `.gitignore`).
#
# REGRAS DE SEGREDO (nunca violar):
#   - NUNCA escreva valor real de segredo aqui (só placeholders `TROCAR_*`).
#   - NUNCA commite `.env`, `.env.prod` ou `.env.prod.new`.
#   - NUNCA cole segredo em log, issue, PR ou chat.
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Ambiente
# -----------------------------------------------------------------------------
# Produção na VPS: `production`. Desenvolvimento local: `development`.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Swagger UI (serve docs/openapi.yaml). Default: ligado fora de produção; em
# PROD exige explicitamente `true` (fail-closed). Path do UI e da spec bruta:
# {SWAGGER_PATH} · {SWAGGER_PATH}-json · {SWAGGER_PATH}-yaml.
SWAGGER_ENABLED=true
# SWAGGER_PATH=docs
# OPENAPI_SPEC_PATH=/app/docs/openapi.yaml
# Driver das filas BullMQ da API. `memory` (default) = fila in-memory: nada vai
# ao Redis (em PROD o boot registra ERROR, nunca fica silencioso). `bullmq` =
# Queue real, exige Redis de pé — ligue JUNTO com o wiring dos workers
# (decisão D-B: "não ativar o pipeline").
QUEUE_DRIVER=memory

# -----------------------------------------------------------------------------
# 1. Postgres — BANCO CONSOLIDADO `aurumbit` + ROLES POR DOMÍNIO (E2/E3)
# -----------------------------------------------------------------------------
# Modelo: UM database `aurumbit` com 9 schemas
# (auth customers products access licensing billing finance audit communications),
# criado por `deploy/init-dbs.sh` + `deploy/init-consolidated.sql` (idempotentes).
# Cada domínio tem um ROLE mínimo; o app fala via PgBouncer 6432
# (pool_mode transaction). Exceções: `licensing` (bypass h1 — direto 5432) e o
# `migrator` (migrate one-shot, direto 5432, nunca lido pelo app).
# Senhas: 1 por role (hex URL-safe — sem `@ / + :` — pois vão p/ DSNs).
#   DEV: compose/init-dbs.sh aplicam defaults fracos locais quando ausentes.
#   PROD: gere com `bash deploy/scripts/gen-prod-env.sh` (nunca reuse dev).
POSTGRES_USER=aurum
POSTGRES_PASSWORD=TROCAR_SENHA_FORTE_GERADA
POSTGRES_DB=aurumbit
POSTGRES_PORT=5432

# Senhas por role (PROD: geradas; DEV: defaults do init-dbs.sh valem se vazias).
MIGRATOR_PASSWORD=TROCAR_MIGRATOR_PASSWORD_GERADA
APP_AUTH_PASSWORD=TROCAR_APP_AUTH_PASSWORD_GERADA
APP_CUSTOMERS_PASSWORD=TROCAR_APP_CUSTOMERS_PASSWORD_GERADA
APP_PRODUCTS_PASSWORD=TROCAR_APP_PRODUCTS_PASSWORD_GERADA
APP_ACCESS_PASSWORD=TROCAR_APP_ACCESS_PASSWORD_GERADA
APP_LICENSING_PASSWORD=TROCAR_APP_LICENSING_PASSWORD_GERADA
APP_BILLING_PASSWORD=TROCAR_APP_BILLING_PASSWORD_GERADA
APP_FINANCE_PASSWORD=TROCAR_APP_FINANCE_PASSWORD_GERADA
APP_AUDIT_APPEND_PASSWORD=TROCAR_APP_AUDIT_APPEND_PASSWORD_GERADA
APP_COMMUNICATIONS_PASSWORD=TROCAR_APP_COMMUNICATIONS_PASSWORD_GERADA
APP_FINANCE_REPORTS_PASSWORD=TROCAR_APP_FINANCE_REPORTS_PASSWORD_GERADA
APP_AUDIT_READ_PASSWORD=TROCAR_APP_AUDIT_READ_PASSWORD_GERADA

# URLs por domínio (E2/E3: mesmo host/banco, variando role + ?schema=<dom>).
# DEV (ferramentas do HOST: migrate/seed apontam p/ localhost):
# PROD (host): troque `localhost` pelo host real e as senhas pelas geradas acima.
# DENTRO do compose, os serviços `api`/`workers` usam os hosts `pgbouncer`
# (6432) e `postgres` (5432, só licensing/migrator) via valores do compose —
# estas variáveis servem ao tooling executado FORA dos containers.
# `connection_limit` espelha o CONNECTION LIMIT do role (ver init-consolidated.sql).
DATABASE_URL_AUTH=postgresql://app_auth:TROCAR_APP_AUTH_PASSWORD_GERADA@localhost:6432/aurumbit?schema=auth&pgbouncer=true&connection_limit=20
DATABASE_URL_CUSTOMERS=postgresql://app_customers:TROCAR_APP_CUSTOMERS_PASSWORD_GERADA@localhost:6432/aurumbit?schema=customers&pgbouncer=true&connection_limit=15
DATABASE_URL_PRODUCTS=postgresql://app_products:TROCAR_APP_PRODUCTS_PASSWORD_GERADA@localhost:6432/aurumbit?schema=products&pgbouncer=true&connection_limit=15
DATABASE_URL_ACCESS=postgresql://app_access:TROCAR_APP_ACCESS_PASSWORD_GERADA@localhost:6432/aurumbit?schema=access&pgbouncer=true&connection_limit=20
DATABASE_URL_LICENSING=postgresql://app_licensing:TROCAR_APP_LICENSING_PASSWORD_GERADA@localhost:5432/aurumbit?schema=licensing&connection_limit=20
DATABASE_URL_BILLING=postgresql://app_billing:TROCAR_APP_BILLING_PASSWORD_GERADA@localhost:6432/aurumbit?schema=billing&pgbouncer=true&connection_limit=15
DATABASE_URL_FINANCE=postgresql://app_finance:TROCAR_APP_FINANCE_PASSWORD_GERADA@localhost:6432/aurumbit?schema=finance&pgbouncer=true&connection_limit=10
DATABASE_URL_AUDIT=postgresql://app_audit_append:TROCAR_APP_AUDIT_APPEND_PASSWORD_GERADA@localhost:6432/aurumbit?schema=audit&pgbouncer=true&connection_limit=10
DATABASE_URL_COMMUNICATIONS=postgresql://app_communications:TROCAR_APP_COMMUNICATIONS_PASSWORD_GERADA@localhost:6432/aurumbit?schema=communications&pgbouncer=true&connection_limit=15
# Leitores: só SELECT (reports p/ finance, read p/ audit) — limite 5.
DATABASE_URL_FINANCE_REPORTS=postgresql://app_finance_reports:TROCAR_APP_FINANCE_REPORTS_PASSWORD_GERADA@localhost:6432/aurumbit?schema=finance&pgbouncer=true&connection_limit=5
DATABASE_URL_AUDIT_READ=postgresql://app_audit_read:TROCAR_APP_AUDIT_READ_PASSWORD_GERADA@localhost:6432/aurumbit?schema=audit&pgbouncer=true&connection_limit=5
# Migrator: DDL dos 9 schemas, DIRETO no Postgres (sem pgbouncer), nunca lido pelo app.
MIGRATOR_DATABASE_URL=postgresql://migrator:TROCAR_MIGRATOR_PASSWORD_GERADA@localhost:5432/aurumbit
# Compat: alguns scripts antigos referenciam `DATABASE_URL` (singular) como
# alias do domínio `auth`. Em prod, aponte-o para `auth` (via pgbouncer).
DATABASE_URL=postgresql://app_auth:TROCAR_APP_AUTH_PASSWORD_GERADA@localhost:6432/aurumbit?schema=auth&pgbouncer=true&connection_limit=20

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 2. JWT / API (fail-fast no boot se inválido — ver `env.schema.ts`)
# -----------------------------------------------------------------------------
# PROD: gere um segredo aleatório com ao menos 32 bytes. Nunca use o default
# `test-only-*` em produção (o schema exige mín. 16 chars; prod exige 32+ bytes).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=TROCAR_JWT_SECRET_GERADO_MIN_32_BYTES
JWT_ISS=aurum-bit
JWT_AUD=aurum-clients
JWT_TTL=15m
# AUTH_JWT_SECRET: NÃO declare. O `AuthService` assina com ele (precedência sobre
# JWT_SECRET) mas o `JwtAuthGuard` valida SÓ com JWT_SECRET — divergentes = 401
# em toda request (o `env.schema.ts` agora aborta o boot nessa divergência).

# Chave DEDICADA do segredo TOTP (MFA). OBRIGATÓRIA em produção: sem ela o boot
# aborta. Gere com 32 bytes (64 hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NÃO derive de JWT_SECRET (rotacionar o JWT derrubaria o MFA de todo mundo).
# Guarde no cofre/backups: perdê-la torna TODO segredo TOTP ilegível.
MFA_ENC_KEY=TROCAR_MFA_ENC_KEY_GERADA_64_HEX
# MFA_ENC_KEY_PREVIOUS=<chave-anterior> — só na ROTAÇÃO (lista separada por
# vírgula), para não invalidar o MFA já emitido. Fora da rotação: deixar AUSENTE
# (vazio reprova a validação).

# CORS — ATENÇÃO À DIVERGÊNCIA DE NOMES (não renomear sem alinhar os 3 pontos):
#   - A API lê `CORS_ORIGINS` (plural, `apps/api/src/config/env.schema.ts`).
#   - O compose injeta `CORS_ORIGIN` (singular) nos serviços.
# Em prod, defina AMBAS com o mesmo valor até a padronização (T1) unificar.
# PROD: origem pública do portal. Nunca `*` (a API ignora `*` fail-closed).
CORS_ORIGIN=https://aurumbit.com
CORS_ORIGINS=https://aurumbit.com

# -----------------------------------------------------------------------------
# 3. Chaves internas worker<->API (fail-closed: sem elas, sync/apply = 503)
# -----------------------------------------------------------------------------
# Gerar cada uma com (64 hex, 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_WEBHOOK_KEY=TROCAR_64_HEX_GERADO
INTERNAL_PROJECTION_KEY=TROCAR_64_HEX_GERADO

# -----------------------------------------------------------------------------
# 4. MESTRA DE LICENÇA — ENVELOPE v2 (checkpoint Fase 7 §6)
# -----------------------------------------------------------------------------
# Cifra AES-256-GCM em envelope da reemissão de chaves de licença
# (`v2.<masterVer>.<encDEK>.<iv>.<ct>.<tag>`; DEK de 32B por chave).
# A mestra vive em ARQUIVO (nunca neste .env): 64 hex (32 bytes), `chmod 600`:
#   node -e "require('fs').writeFileSync('config/license-master.key', require('crypto').randomBytes(32).toString('hex')+'\n', {mode:0o600})"
# Sem mestra válida, o endpoint `reveal` responde 409 honesto (by design) — o
# boot NÃO trava, mas nenhuma licença emitida pode ser reexibida.
# PERDER a mestra = IRREVERSÍVEL: licenças já emitidas ficam indecifráveis.
# CHECKPOINT OBRIGATÓRIO: incluir o arquivo da mestra no backup cifrado (T5)
# e guardar cópia cifrada OFF-VPS ANTES de emitir a primeira licença real.
# Rotação sem downtime (ver docs/SECURITY.md §K3): gere a nova, aponte
# LICENSE_MASTER_KEY_PATH p/ ela, ponha a antiga em
# LICENSE_MASTER_KEY_PREVIOUS_PATH, re-cifre sob demanda; zere a antiga
# quando `key_enc LIKE 'v2.v1.%'` chegar a 0. KMS com rotação: Fase 5+.
# Legado dev: a env antiga de 64 hex ainda abre envelopes `v1.*` — só compat,
# nunca em prod.
LICENSE_MASTER_KEY_PATH=/run/secrets/license-master-key
# LICENSE_MASTER_KEY_PREVIOUS_PATH=/run/secrets/license-master-key.prev
# (E2/E3: o compose monta o arquivo gerado por gen-prod-env.sh nesse caminho;
# fora do compose, aponte p/ o arquivo local, ex. config/license-master.key.)
# REMOVIDO (E8): LICENSE_KEY_ENC_KEY (valor direto no .env) — NÃO recriar.

# -----------------------------------------------------------------------------
# 5. Asaas — PROD (nada de sandbox em produção)
# -----------------------------------------------------------------------------
# PROD: URL oficial (sandbox é só dev):
ASAAS_API_URL=https://api.asaas.com/api/v3
# DEV (sandbox): https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=TROCAR_ASAAS_API_KEY_PROD_DO_COFRE
ASAAS_WEBHOOK_SECRET=TROCAR_ASAAS_WEBHOOK_SECRET_PROD
# CSV de IPs/ranges autorizados a chamar o webhook (vazio = aceita pelo token +
# warn no log; PRODUÇÃO: fixar os ranges oficiais publicados pela Asaas).
# ASAAS_IP_ALLOWLIST=
# Primeira cobrança real: validar em valor mínimo COM ESTORNO (gate §6) e
# confirmar a URL de webhook no painel Asaas PROD (T6).

# -----------------------------------------------------------------------------
# 6. Resend — PROD (domínio real verificado)
# -----------------------------------------------------------------------------
# PROD: chave `re_*` do painel Resend (conta prod) + remetente no domínio real
# verificado (ex. `no-reply@aurumbit.com`). Exige SPF/DKIM/DMARC configurados
# ANTES do corte de DNS (T4) — sem eles, o transacional não é entregue.
RESEND_API_KEY=TROCAR_RESEND_API_KEY_PROD_DO_COFRE
RESEND_FROM=no-reply@aurumbit.com
# DEV local (Mailhog via compose): SMTP_HOST/SMTP_PORT abaixo.
SMTP_HOST=mailhog
SMTP_PORT=1025

# -----------------------------------------------------------------------------
# 7. Frontend / portal (CUIDADO: NEXT_PUBLIC_* assa no build)
# -----------------------------------------------------------------------------
# `NEXT_PUBLIC_*` são embutidas no bundle JS no `next build` — TROCAR valor
# exige REBUILD + REDEPLOY da imagem do portal/admin. Nunca espere mudança
# só com restart. Build de prod: sempre no Linux (CI/VPS), nunca no Windows
# (divergência `standalone` win32 vs Linux).
# PROD (portal + admin):
NEXT_PUBLIC_API_URL=https://api.aurumbit.com
NEXT_PUBLIC_SITE_URL=https://aurumbit.com
# BFF server-side do portal → API DENTRO da rede do compose (não exposto):
API_INTERNAL_URL=http://api:3000
# DEV local: API_INTERNAL_URL=http://localhost:3000,
# NEXT_PUBLIC_SITE_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# 8. ADMIN_DEV_OPEN — AUSENTE EM PROD (aviso explícito)
# -----------------------------------------------------------------------------
# `ADMIN_DEV_OPEN=1` libera TODAS as telas do admin com mock, SEM login.
# NUNCA definir em produção, nem comentado com valor — esta variável NÃO EXISTE
# no `.env.prod`. Se existir em qualquer ambiente real, é incidente de segurança.
# (Dev local do admin sem backend: exporte `ADMIN_DEV_OPEN=1` só no shell local,
# jamais em arquivo commitado.)
# ADMIN_DEV_OPEN — NÃO ADICIONAR AQUI NEM NO .env.prod. NUNCA EM PROD.

# -----------------------------------------------------------------------------
# 9. NOMES CANÔNICOS (E2/E3)
# -----------------------------------------------------------------------------
# CANÔNICO (E2/E3): UM database `aurumbit` (POSTGRES_DB) com 9 SCHEMAS
# (`auth customers products access licensing billing finance audit
# communications`), criados por `deploy/init-dbs.sh` + `init-consolidated.sql`.
#   - Roles: `migrator` + `app_<dom>` (+ `app_finance_reports`, `app_audit_read`).
#   - Hosts de container: `postgres` (5432), `pgbouncer` (6432), `redis`, `api`.
# O quê vale onde:
#   - compose `api`/`workers`: URLs por role c/ host `pgbouncer` (fonte atual).
#   - `DATABASE_URL_*` deste arquivo: HOST-side (migrate/seed) — ver §1.
#   - `init-dbs.sh`: garante `aurumbit` + aplica o SQL consolidado.
# DIVERGÊNCIA CONHECIDA (não renomear unilateralmente — alinhar T1):
#   - `CORS_ORIGIN` (compose) vs `CORS_ORIGINS` (API schema): definir ambas (§2).
#   - `DATABASE_URL` (singular): URL do schema `auth` (health + fallback auth).

# -----------------------------------------------------------------------------
# 10. Observabilidade / misc
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=aurum-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Galeria de produtos em disco (fora do repo; compose monta volume dedicado).
# No container: `/var/lib/aurum/product-images` (volume `product-images`).
# PRODUCT_IMAGES_DIR=./data/product-images

# Portas só para DEV (compose prod expõe só 127.0.0.1 — T1):
# API_PORT=3000
# ADMIN_PORT=3001
# MAILHOG_SMTP_PORT=1025
# MAILHOG_HTTP_PORT=8025
