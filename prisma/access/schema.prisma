generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output   = "../../node_modules/.prisma/access"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_ACCESS")
  schemas = ["access"]
}

// Fase 2 — Access base (sem LicenseDevice/offline-token → Fase 3; sem Asaas/Billing).
// single-DB aurumbit, schema access: owner/product/plan/feature são Strings opacas resolvidas na
// aplicação (products via catálogo, customers via identidade).
// Entitlement é a fonte da verdade p/ check-access (REQUIREMENTS.md §2).
// Prioridades: BONUS=5 < CONTRACT=10 < SUBSCRIPTION=20 < LICENSE=30 (maior vence).

model AccessGrant {
  id        String   @id @default(cuid())
  // Referência opaca cross-DB — origem: auth.UserIdentity.id. Sem @relation cross-DB.
  subjectId String
  // Referência opaca cross-DB — origem: customers.Customer.id (organização). Sem @relation cross-DB.
  orgId     String
  role      String // ex.: ADMIN, FINANCE (finance.read), MEMBER
  reason    String?
  createdAt DateTime @default(now())

  @@unique([subjectId, orgId, role])
  @@map("access_grants")
  @@schema("access")
}

// Contrato de acesso. Congela preço no ContractItem.unitPriceCents
// (REQUIREMENTS.md §2: "Contract congela preço").
model Contract {
  id        String    @id @default(cuid())
  ownerType String // CUSTOMER | ORGANIZATION
  ownerId   String // titular opaco cross-DB (customers). Sem FK cross-DB.
  status    String    @default("DRAFT") // DRAFT | ACTIVE | SUSPENDED | CANCELLED | EXPIRED
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())

  items ContractItem[]

  @@index([ownerType, ownerId])
  @@index([status])
  @@map("contracts")
  @@schema("access")
}

model ContractItem {
  id             String    @id @default(cuid())
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId     String
  planId         String // opaco cross-DB: products.ProductPlan.id
  productId      String // opaco cross-DB: products.Product.id
  unitPriceCents Int // CONGELADO na contratação; imutável (sem endpoint de update)
  quantity       Int       @default(1)
  status         String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVE | SUSPENDED | CANCELLED | EXPIRED
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())

  @@index([contractId])
  @@index([status])
  @@map("contract_items")
  @@schema("access")
}

// Fonte da verdade do check-access. UNIQUE cobre owner+product+feature+origin+
// origin_id (REQUIREMENTS.md §2) mais ownerType p/ isolar PF vs organização.
model Entitlement {
  id          String    @id @default(cuid())
  ownerType   String // CUSTOMER | ORGANIZATION
  ownerId     String // titular opaco cross-DB
  productId   String // opaco cross-DB: products.Product.id
  featureCode String // opaco cross-DB: products.Feature.code
  // Fase 8: canal denormalizado da feature no momento da concessão
  // (WEB | DESKTOP | BOTH). check-access filtra por ele; UNIQUE 6-col
  // preservada (channel não identifica a concessão, só o gating).
  channel   String @default("BOTH") // WEB | DESKTOP | BOTH
  origin      String // CONTRACT | SUBSCRIPTION | LICENSE | BONUS
  originId    String // id da origem dentro do domínio dono
  priority    Int // BONUS=5 | CONTRACT=10 | SUBSCRIPTION=20 | LICENSE=30
  status      String    @default("ACTIVE") // ACTIVE | GRACE | SUSPENDED | EXPIRED | REVOKED
  quotaValue  String?
  startsAt    DateTime?
  expiresAt   DateTime?
  graceUntil  DateTime? // expires_at + 3d (PROJECT.md §1); janela degradada
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@unique([ownerType, ownerId, productId, featureCode, origin, originId])
  @@index([ownerId, status])
  @@index([status, expiresAt])
  // Fase 9 (ADR-006 §8): caminho quente check-access; map = nome do índice
  // criado na migration 0003 (zero-drift no migrate diff).
  @@index([ownerId, productId, featureCode], map: "idx_entitlements_lookup")
  @@map("entitlements")
  @@schema("access")
}

// Cortesia. reason >= 10 chars (validado na API). ends_at null = vitalícia
// (ainda assim revogável → status REVOKED).
model BonusGrant {
  id          String    @id @default(cuid())
  ownerType   String
  ownerId     String
  productId   String? // null = todos os produtos
  featureCode String? // null = todas as features
  reason      String
  endsAt      DateTime? // null = vitalícia
  status      String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  grantedBy   String // actor opaco (admin subjectId)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@index([ownerId, status])
  @@map("bonus_grants")
  @@schema("access")
}

// Trilha de ajustes manuais (suspend/revoke/cancel...). reason >= 10 chars.
model AccessAdjustment {
  id         String   @id @default(cuid())
  actor      String // quem executou (admin subjectId)
  action     String // ex.: entitlement.suspend, bonus.revoke, contract.cancel
  targetType String? // ENTITLEMENT | BONUS | CONTRACT
  targetId   String?
  reason     String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@map("access_adjustments")
  @@schema("access")
}

model OutboxEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  aggregate   String
  aggregateId String
  type        String
  payload     Json
  occurredAt  DateTime @default(now())
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("outbox_events")
  @@schema("access")
}

