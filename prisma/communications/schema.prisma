generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output   = "../../node_modules/.prisma/communications"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_COMMUNICATIONS")
  schemas = ["communications"]
}

// Fase 4 — Resend + templates reais (PROJECT.md §§5-6, REQUIREMENTS.md §4).
// - Idempotência: `eventId` UNIQUE global (= BullMQ jobId = Resend
//   idempotencyKey). `INSERT ... ON CONFLICT ("eventId") DO NOTHING` →
//   replay nunca duplica envio (segunda camada: Resend idempotencyKey).
// - LGPD: e-mail cru NUNCA persiste (só transita fila→Resend em memória).
//   Guarda `recipientHash` (SHA256 do normalizado, p/ busca) + `recipientMasked`
//   (`d***@dominio`, p/ suporte). Vars de template sensíveis (code/token)
//   são redigidas antes de persistir (`variables`); o render usa as vars
//   do job em memória. Retenção vars 90d (REQUIREMENTS §4).
enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  BOUNCED
  COMPLAINED
  @@schema("communications")
}

model EmailMessage {
  id              String      @id @default(cuid())
  eventId         String      @unique
  correlationId   String?
  recipientHash   String
  recipientMasked String
  template        String
  templateVersion String      @default("v1")
  resendId        String?     @unique
  status          EmailStatus @default(QUEUED)
  variables       Json?
  attempts        Int         @default(0)
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt @default(now())

  @@index([status])
  @@index([recipientHash])
  @@index([template, templateVersion])
  @@map("email_messages")
  @@schema("communications")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  version   String   @default("v1")
  subject   String
  body      String
  variables Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@unique([name, version])
  @@map("email_templates")
  @@schema("communications")
}

// Dedupe de webhooks Resend (PROJECT.md §5: UNIQUE por evento → 200 duplicate).
// `externalId` = id do evento no Resend; `emailId` = email_id alvo.
model WebhookReceipt {
  id         String   @id @default(cuid())
  provider   String   @default("resend")
  externalId String   @unique
  emailId    String?
  type       String
  createdAt  DateTime @default(now())

  @@map("webhook_receipts")
  @@schema("communications")
}

// Ponte de atendimento em tempo real (portal ↔ admin).
// - `guestToken` autentica o visitante sem login (header `x-chat-token` / `?token=` no SSE).
// - LGPD: só nome + e-mail do visitante; corpo da mensagem é funcional do suporte.
//   Retenção 90d (mesma do domínio communications).
enum ChatConversationStatus {
  OPEN
  PENDING
  ACTIVE
  CLOSED
  @@schema("communications")
}

enum ChatSender {
  VISITOR
  AGENT
  SYSTEM
  @@schema("communications")
}

enum ChatMessageStatus {
  SENT
  DELIVERED
  READ
  @@schema("communications")
}

model ChatConversation {
  id            String                   @id
  guestToken    String                   @unique
  visitorName   String
  visitorEmail  String?
  origin        String                   @default("landpage")
  triage        Json?
  status        ChatConversationStatus   @default(OPEN)
  assignee      String?
  customerId    String?
  lastMessageAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt @default(now())
  // Lixeira auditável (tela de arquivados): `null` = na fila ativa.
  archivedAt    DateTime?
  messages      ChatMessage[]

  @@index([status])
  @@index([lastMessageAt])
  @@index([archivedAt])
  @@map("chat_conversations")
  @@schema("communications")
}

model ChatMessage {
  id             String            @id
  conversationId String
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ChatSender
  authorName     String
  body           String
  status         ChatMessageStatus @default(SENT)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
  @@schema("communications")
}

